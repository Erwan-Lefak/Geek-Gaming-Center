# Environment Variables for Vercel Production
# Copy this to Vercel Dashboard: Settings > Environment Variables

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=https://your-production-url.vercel.app
NEXTAUTH_URL=https://your-production-url.vercel.app
NEXT_PUBLIC_API_URL=https://your-production-url.vercel.app/api

# --- Email Service (Resend) ---
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Geek Gaming Center <support@geek-gaming-center.cam>
EMAIL_REPLY_TO=support@geek-gaming-center.cam
ADMIN_EMAIL=your-admin-email@gmail.com

# --- Database ---
# Already configured in Vercel (Vercel Postgres or Prisma Postgres)
# DATABASE_URL, POSTGRES_URL, PRISMA_DATABASE_URL are auto-configured

# --- NextAuth ---
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_minimum_32_characters

# --- Stripe (Payments) ---
# Get your keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public Info ---
NEXT_PUBLIC_APP_NAME=Geek Gaming Center
