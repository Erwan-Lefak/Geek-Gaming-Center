generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid()) @map("id")
  email     String    @unique @map("email")
  password  String    @map("password")
  name      String    @map("name")
  role      String    @default("CASHIER") @map("role")
  phone     String?   @map("phone")
  isActive  Boolean?  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("users")
}

model Customer {
  id                     String         @id @default(cuid()) @map("id")
  firstName              String         @map("first_name")
  lastName               String         @map("last_name")
  email                  String?        @unique @map("email")
  phone                  String         @map("phone")
  dateOfBirth            DateTime?      @map("date_of_birth") @db.Timestamp(6)
  address                String?        @map("address")
  city                   String?        @map("city")
  status                 String?        @default("NEW") @map("status")
  notes                  String?        @map("notes")
  acceptCGV              Boolean?       @default(false) @map("accept_cgv")
  cgvAcceptedAt          DateTime?      @map("cgv_accepted_at") @db.Timestamp(6)
  totalSpent             Decimal?       @default(0) @map("total_spent") @db.Decimal(12, 2)
  totalHours             Decimal?       @default(0) @map("total_hours") @db.Decimal(10, 2)
  visitCount             Int?           @default(0) @map("visit_count")
  lastVisit              DateTime?      @map("last_visit") @db.Timestamp(6)
  createdById            String         @map("created_by_id")
  createdAt              DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  password                  String?        @map("password")
  password_plain            String?        @map("password_plain")
  is_active                 Boolean?       @default(true) @map("is_active")
  email_verified            DateTime?      @map("email_verified") @db.Timestamp(6)
  email_verification_token  String?        @unique @map("email_verification_token")
  email_verification_expires DateTime?     @map("email_verification_expires") @db.Timestamp(6)
  password_reset_token      String?        @unique @map("password_reset_token")
  password_reset_expires    DateTime?      @map("password_reset_expires") @db.Timestamp(6)
  howDidYouFindUs        String?        @map("how_did_you_find_us")
  howDidYouFindUsDetails String?        @map("how_did_you_find_us_details")
  eventBookings          EventBooking[]
  orders                 Order[]

  @@index([password_reset_token], map: "idx_customers_password_reset_token")
  @@map("customers")
}

model Equipment {
  id              String           @id @default(cuid()) @map("id")
  name            String           @map("name")
  type            EquipmentType    @map("type")
  code            String           @unique @map("code")
  status          EquipmentStatus? @default(AVAILABLE) @map("status")
  specifications  Json?            @map("specifications")
  location        String?          @map("location")
  lastMaintenance DateTime?        @map("last_maintenance") @db.Timestamp(6)
  nextMaintenance DateTime?        @map("next_maintenance") @db.Timestamp(6)
  healthScore     Int?             @default(100) @map("health_score")
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([code], map: "idx_equipment_code")
  @@index([status], map: "idx_equipment_status")
  @@index([type], map: "idx_equipment_type")
  @@map("equipment")
}

model Pricing {
  id          String    @id @default(cuid()) @map("id")
  equipmentId String    @map("equipment_id")
  duration    Int       @map("duration")
  isWeekend   Boolean?  @default(false) @map("is_weekend")
  price       Decimal   @map("price") @db.Decimal(10, 2)
  currency    String?   @default("XAF") @map("currency")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([equipmentId, duration, isWeekend])
  @@index([equipmentId], map: "idx_pricing_equipment")
  @@map("pricing")
}

model GamingSession {
  id             String         @id @default(cuid()) @map("id")
  sessionNumber  String         @unique @map("session_number")
  customerId     String         @map("customer_id")
  equipmentId    String         @map("equipment_id")
  pricingId      String         @map("pricing_id")
  duration       Int            @map("duration")
  price          Decimal        @map("price") @db.Decimal(10, 2)
  status         SessionStatus? @default(PENDING) @map("status")
  paidAt         DateTime       @map("paid_at") @db.Timestamp(6)
  startedAt      DateTime?      @map("started_at") @db.Timestamp(6)
  scheduledEndAt DateTime       @map("scheduled_end_at") @db.Timestamp(6)
  actualEndAt    DateTime?      @map("actual_end_at") @db.Timestamp(6)
  gracePeriodEnd DateTime?      @map("grace_period_end") @db.Timestamp(6)
  notes          String?        @map("notes")
  createdById    String         @map("created_by_id")
  createdAt      DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  invoiceId      String?        @unique @map("invoice_id")

  @@index([customerId], map: "idx_sessions_customer")
  @@index([scheduledEndAt], map: "idx_sessions_end_at")
  @@index([equipmentId], map: "idx_sessions_equipment")
  @@index([sessionNumber], map: "idx_sessions_number")
  @@index([status], map: "idx_sessions_status")
  @@map("gaming_sessions")
}

model SessionExtension {
  id                String    @id @default(cuid()) @map("id")
  sessionId         String    @map("session_id")
  additionalMinutes Int       @map("additional_minutes")
  additionalPrice   Decimal   @map("additional_price") @db.Decimal(10, 2)
  extendedAt        DateTime? @default(now()) @map("extended_at") @db.Timestamp(6)

  @@index([sessionId], map: "idx_session_extensions_session")
  @@map("session_extensions")
}

model Invoice {
  id                  String         @id @default(cuid()) @map("id")
  invoiceNumber       String         @unique @map("invoice_number")
  invoiceDate         DateTime?      @default(now()) @map("invoice_date") @db.Timestamp(6)
  dueDate             DateTime?      @map("due_date") @db.Timestamp(6)
  customerId          String         @map("customer_id")
  subtotal            Decimal        @map("subtotal") @db.Decimal(12, 2)
  taxRate             Decimal?       @default(19.25) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal        @map("tax_amount") @db.Decimal(12, 2)
  total               Decimal        @map("total") @db.Decimal(12, 2)
  discount            Decimal?       @default(0) @map("discount") @db.Decimal(10, 2)
  paymentMethod       PaymentMethod  @map("payment_method")
  paymentStatus       PaymentStatus? @default(PENDING) @map("payment_status")
  paidAt              DateTime?      @map("paid_at") @db.Timestamp(6)
  mobileMoneyProvider String?        @map("mobile_money_provider")
  mobileMoneyPhone    String?        @map("mobile_money_phone")
  mobileMoneyRef      String?        @map("mobile_money_ref")
  type                InvoiceType    @map("type")
  notes               String?        @map("notes")
  createdById         String         @map("created_by_id")
  createdAt           DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([customerId], map: "idx_invoices_customer")
  @@index([invoiceDate], map: "idx_invoices_date")
  @@index([invoiceNumber], map: "idx_invoices_number")
  @@index([paymentStatus], map: "idx_invoices_payment_status")
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid()) @map("id")
  invoiceId   String  @map("invoice_id")
  productId   String? @map("product_id")
  description String  @map("description")
  quantity    Int     @map("quantity")
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(10, 2)

  @@index([invoiceId], map: "idx_invoice_items_invoice")
  @@index([productId], map: "idx_invoice_items_product")
  @@map("invoice_items")
}

model Product {
  id             String    @id @default(cuid()) @map("id")
  name           String    @map("name")
  description    String?   @map("description")
  category       String    @map("category")
  subcategory    String?   @map("subcategory")
  brand          String?   @map("brand")
  sku            String    @unique @map("sku")
  costPrice      Decimal   @map("cost_price") @db.Decimal(10, 2)
  sellingPrice   Decimal   @map("selling_price") @db.Decimal(10, 2)
  currency       String?   @default("XAF") @map("currency")
  currentStock   Int?      @default(0) @map("current_stock")
  minStock       Int?      @default(5) @map("min_stock")
  maxStock       Int?      @default(50) @map("max_stock")
  reorderPoint   Int?      @default(10) @map("reorder_point")
  supplierId     String?   @map("supplier_id")
  images         String[]  @map("images")
  thumbnail      String?   @map("thumbnail")
  isActive       Boolean?  @default(true) @map("is_active")
  isFeatured     Boolean?  @default(false) @map("is_featured")
  specifications Json?     @map("specifications")
  tags           String[]  @map("tags")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([category], map: "idx_products_category")
  @@index([sku], map: "idx_products_sku")
  @@index([currentStock], map: "idx_products_stock")
  @@map("products")
}

model StockMovement {
  id         String       @id @default(cuid()) @map("id")
  productId  String       @map("product_id")
  quantity   Int          @map("quantity")
  type       MovementType @map("type")
  reason     String?      @map("reason")
  reference  String?      @map("reference")
  unitCost   Decimal?     @map("unit_cost") @db.Decimal(10, 2)
  totalValue Decimal?     @map("total_value") @db.Decimal(12, 2)
  createdAt  DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt], map: "idx_stock_movements_date")
  @@index([productId], map: "idx_stock_movements_product")
  @@index([type], map: "idx_stock_movements_type")
  @@map("stock_movements")
}

model Supplier {
  id            String    @id @default(cuid()) @map("id")
  name          String    @map("name")
  contactPerson String?   @map("contact_person")
  email         String?   @map("email")
  phone         String    @map("phone")
  address       String?   @map("address")
  city          String?   @map("city")
  country       String?   @default("Cameroun") @map("country")
  paymentTerms  String?   @map("payment_terms")
  leadTime      Int?      @map("lead_time")
  notes         String?   @map("notes")
  isActive      Boolean?  @default(true) @map("is_active")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("suppliers")
}

model Reservation {
  id                 String             @id @default(cuid()) @map("id")
  reservationNumber  String             @unique @map("reservation_number")
  customerId         String             @map("customer_id")
  equipmentId        String             @map("equipment_id")
  startTime          DateTime           @map("start_time") @db.Timestamp(6)
  endTime            DateTime           @map("end_time") @db.Timestamp(6)
  duration           Int                @map("duration")
  estimatedPrice     Decimal            @map("estimated_price") @db.Decimal(10, 2)
  depositAmount      Decimal            @map("deposit_amount") @db.Decimal(10, 2)
  depositPaid        Boolean?           @default(false) @map("deposit_paid")
  depositPaidAt      DateTime?          @map("deposit_paid_at") @db.Timestamp(6)
  status             ReservationStatus? @default(PENDING) @map("status")
  confirmedAt        DateTime?          @map("confirmed_at") @db.Timestamp(6)
  reminderSent       Boolean?           @default(false) @map("reminder_sent")
  reminderSentAt     DateTime?          @map("reminder_sent_at") @db.Timestamp(6)
  noShow             Boolean?           @default(false) @map("no_show")
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamp(6)
  cancellationReason String?            @map("cancellation_reason")
  notes              String?            @map("notes")
  createdAt          DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([customerId], map: "idx_reservations_customer")
  @@index([equipmentId], map: "idx_reservations_equipment")
  @@index([startTime], map: "idx_reservations_start")
  @@index([status], map: "idx_reservations_status")
  @@map("reservations")
}

model MaintenanceTicket {
  id           String        @id @default(cuid()) @map("id")
  ticketNumber String        @unique @map("ticket_number")
  equipmentId  String        @map("equipment_id")
  title        String        @map("title")
  description  String        @map("description")
  priority     Priority?     @default(MEDIUM) @map("priority")
  status       TicketStatus? @default(OPEN) @map("status")
  diagnosis    String?       @map("diagnosis")
  solution     String?       @map("solution")
  assignedToId String?       @map("assigned_to_id")
  completedAt  DateTime?     @map("completed_at") @db.Timestamp(6)
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamp(6)
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([equipmentId], map: "idx_maintenance_equipment")
  @@index([priority], map: "idx_maintenance_priority")
  @@index([status], map: "idx_maintenance_status")
  @@map("maintenance_tickets")
}

model DailyReport {
  id                  String    @id @default(cuid()) @map("id")
  date                DateTime  @unique @map("date") @db.Timestamp(6)
  dayOfWeek           Int       @map("day_of_week")
  gamingRevenue       Decimal?  @default(0) @map("gaming_revenue") @db.Decimal(12, 2)
  boutiqueRevenue     Decimal?  @default(0) @map("boutique_revenue") @db.Decimal(12, 2)
  totalRevenue        Decimal?  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  taxCollected        Decimal?  @default(0) @map("tax_collected") @db.Decimal(12, 2)
  sessionCount        Int?      @default(0) @map("session_count")
  totalHours          Decimal?  @default(0) @map("total_hours") @db.Decimal(10, 2)
  uniqueCustomers     Int?      @default(0) @map("unique_customers")
  newCustomers        Int?      @default(0) @map("new_customers")
  cashPayments        Decimal?  @default(0) @map("cash_payments") @db.Decimal(10, 2)
  mobileMoneyPayments Decimal?  @default(0) @map("mobile_money_payments") @db.Decimal(10, 2)
  cardPayments        Decimal?  @default(0) @map("card_payments") @db.Decimal(10, 2)
  topEquipment        Json?     @map("top_equipment")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([date], map: "idx_daily_reports_date")
  @@map("daily_reports")
}

model MonthlyReport {
  id                 String    @id @default(cuid()) @map("id")
  year               Int       @map("year")
  month              Int       @map("month")
  uniqueDate         DateTime  @unique @map("unique_date") @db.Timestamp(6)
  gamingRevenue      Decimal?  @default(0) @map("gaming_revenue") @db.Decimal(12, 2)
  boutiqueRevenue    Decimal?  @default(0) @map("boutique_revenue") @db.Decimal(12, 2)
  totalRevenue       Decimal?  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  monthlyTarget      Decimal?  @map("monthly_target") @db.Decimal(12, 2)
  targetAchieved     Boolean?  @map("target_achieved")
  achievementRate    Decimal?  @map("achievement_rate") @db.Decimal(5, 2)
  sessionCount       Int?      @default(0) @map("session_count")
  totalHours         Decimal?  @default(0) @map("total_hours") @db.Decimal(10, 2)
  avgSessionDuration Decimal?  @map("avg_session_duration") @db.Decimal(10, 2)
  uniqueCustomers    Int?      @default(0) @map("unique_customers")
  newCustomers       Int?      @default(0) @map("new_customers")
  returningCustomers Int?      @default(0) @map("returning_customers")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([year, month], map: "idx_monthly_reports_year_month")
  @@map("monthly_reports")
}

model CartItem {
  id         String    @id @default(cuid()) @map("id")
  sessionId  String    @unique @map("session_id")
  customerId String?   @map("customer_id")
  productId  String    @map("product_id")
  quantity   Int       @map("quantity")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([customerId], map: "idx_cart_customer")
  @@index([sessionId], map: "idx_cart_session")
  @@map("cart_items")
}

model AuditLog {
  id        String    @id @default(cuid()) @map("id")
  userId    String    @map("user_id")
  action    String    @map("action")
  entity    String    @map("entity")
  entityId  String    @map("entity_id")
  changes   Json?     @map("changes")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt], map: "idx_audit_created")
  @@index([entity], map: "idx_audit_entity")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
}

model Event {
  id          String         @id @default(cuid()) @map("id")
  title       String         @map("title")
  description String         @map("description")
  type        EventType      @map("type")
  eventDate   DateTime       @map("event_date") @db.Timestamp(6)
  startTime   String         @map("start_time") @db.VarChar(10)
  endTime     String?        @map("end_time") @db.VarChar(10)
  price       Int            @default(0) @map("price")
  maxCapacity Int            @map("max_capacity")
  bookedCount Int            @default(0) @map("booked_count")
  imageUrl    String?        @map("image_url")
  location    String?        @map("location")
  isActive    Boolean        @default(true) @map("is_active")
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  bookings    EventBooking[]

  @@index([eventDate])
  @@index([type])
  @@index([isActive, isPublished], map: "events_active_published_idx")
  @@map("events")
}

model EventBooking {
  id              String    @id @default(cuid()) @map("id")
  eventId         String    @map("event_id")
  customerId      String?   @map("customer_id")
  attendeeName    String    @map("attendee_name")
  attendeeEmail   String    @map("attendee_email")
  attendeePhone   String?   @map("attendee_phone")
  numberOfTickets Int       @map("number_of_tickets")
  totalPrice      Int       @map("total_price")
  status          String    @default("confirmed") @map("status") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([eventId])
  @@index([customerId])
  @@index([status])
  @@map("event_bookings")
}

model bookings {
  id                  String       @id @db.VarChar(255)
  customer_id         String       @db.VarChar(255)
  customer_email      String       @db.VarChar(255)
  customer_name       String       @db.VarChar(255)
  customer_phone      String?      @db.VarChar(50)
  slot_ids            String[]
  total_price         Decimal      @db.Decimal(10, 2)
  deposit_amount      Decimal      @db.Decimal(10, 2)
  status              String?      @default("pending") @db.VarChar(50)
  notes               String?
  payment_intent_id   String?      @db.VarChar(255)
  deposit_paid        Boolean?     @default(false)
  no_show_penalty     Boolean?     @default(false)
  cancellation_reason String?
  created_at          DateTime?    @default(now()) @db.Timestamp(6)
  updated_at          DateTime?    @default(now()) @db.Timestamp(6)
  time_slots          time_slots[]

  @@index([customer_id], map: "idx_bookings_customer")
  @@index([status], map: "idx_bookings_status")
}

model resources {
  id                    String       @id @db.VarChar(255)
  name                  String       @db.VarChar(255)
  type                  String       @db.VarChar(50)
  status                String?      @default("available") @db.VarChar(50)
  hourly_rate           Decimal      @db.Decimal(10, 2)
  specifications        Json?
  availability_schedule Json?
  images                Json?        @default("[]")
  description           String?
  created_at            DateTime?    @default(now()) @db.Timestamp(6)
  updated_at            DateTime?    @default(now()) @db.Timestamp(6)
  time_slots            time_slots[]
}

model time_slots {
  id           String    @id @db.VarChar(255)
  resource_id  String    @db.VarChar(255)
  start_time   DateTime  @db.Timestamptz(6)
  end_time     DateTime  @db.Timestamptz(6)
  status       String?   @default("available") @db.VarChar(50)
  price        Decimal   @db.Decimal(10, 2)
  is_peak_hour Boolean?  @default(false)
  booking_id   String?   @db.VarChar(255)
  customer_id  String?   @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  bookings     bookings? @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  resources    resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([resource_id, start_time, end_time], map: "slot_booking_constraint")
  @@index([resource_id], map: "idx_time_slots_resource")
  @@index([status], map: "idx_time_slots_status")
  @@index([start_time, end_time], map: "idx_time_slots_time_range")
}

model MailTemplate {
  id          Int      @id @default(autoincrement()) @map("id")
  mailType    String   @unique @map("mail_type")
  mailSubject String   @map("mail_subject")
  mailBody    String   @map("mail_body")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([mailType])
  @@map("mail_templates")
}

enum UserRole {
  CASHIER
  TECHNICIAN
  MANAGER
  SHAREHOLDER
  ADMIN

  @@map("userrole")
}

enum CustomerStatus {
  NEW
  REGULAR
  VIP
  INACTIVE
  BLOCKED

  @@map("customerstatus")
}

enum EquipmentType {
  PS5
  PS4
  XBOX_SERIES_X
  XBOX_ONE
  PC_GAMING
  OCULUS_VR
  VR_PS4
  SIMU_RACING
  ARCADE
  RETRO

  @@map("equipmenttype")
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
  BROKEN
  RETIRED

  @@map("equipmentstatus")
}

enum SessionStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  CANCELLED

  @@map("sessionstatus")
}

enum InvoiceType {
  GAMING_SESSION
  BOUTIQUE_SALE
  RESERVATION
  CREDIT_NOTE

  @@map("invoicetype")
}

model Order {
  id              String       @id @default(cuid()) @map("id")
  customerId      String       @map("customer_id")
  orderNumber     String       @unique @map("order_number")
  status          OrderStatus  @default(PENDING) @map("status")
  totalAmount     Decimal      @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  notes           String?      @map("notes")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([customerId], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
  @@index([createdAt], map: "idx_orders_created")
  @@map("orders")
}

model OrderItem {
  id              String      @id @default(cuid()) @map("id")
  orderId         String      @map("order_id")
  productId       String      @map("product_id")
  productName     String      @map("product_name")
  quantity        Int         @map("quantity")
  unitPrice       Decimal     @map("unit_price") @db.Decimal(10, 2)
  totalPrice      Decimal     @map("total_price") @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED

  @@map("orderstatus")
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY_ORANGE
  MOBILE_MONEY_MTN
  CARD
  BANK_TRANSFER

  @@map("paymentmethod")
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED

  @@map("paymentstatus")
}

enum MovementType {
  PURCHASE
